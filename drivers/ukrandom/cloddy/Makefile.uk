$(eval $(call addlib_s,libukrandom_cloddy,$(CONFIG_LIBUKRANDOM_CLODDY)))

CINCLUDES-$(CONFIG_LIBUKRANDOM_CLODDY)   += -I$(LIBUKRANDOM_CLODDY_BASE)/include
CXXINCLUDES-$(CONFIG_LIBUKRANDOM_CLODDY) += -I$(LIBUKRANDOM_CLODDY_BASE)/include

# Needed for <kvm/comm_page.h>
LIBUKRANDOM_CLODDY_CINCLUDES-y  += -I$(UK_PLAT_COMMON_BASE)/include
LIBUKRANDOM_CLODDY_CINCLUDES-y  += -I$(UK_PLAT_BASE)/kvm/include

LIBUKRANDOM_CLODDY_SRCS-$(CONFIG_LIBUKBOOT) += $(LIBUKRANDOM_CLODDY_BASE)/init.c
